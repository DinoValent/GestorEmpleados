// Prisma schema — Postgres, migrado desde Notion.
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id               String    @id @default(uuid())
  nombre           String
  estado           String    @default("Activo")
  planId           String?
  plan             Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  /** Etiqueta libre para cuando no hay un Plan del catálogo asignado (ej. "A medida"). */
  planLabel        String?
  maxEmpleados     Int       @default(999999)
  maxAdmins        Int       @default(999999)
  /** Días de tolerancia después de fechaVencimiento antes de pasar a modo solo lectura. */
  diasGracia       Int       @default(5)
  fechaVencimiento DateTime? @db.Date
  /** Si está seteado, esta empresa es una sucursal de un grupo (plan corporativo). */
  grupoId          String?
  grupo            EmpresaGrupo? @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  /** Dirección o etiqueta para identificar la sucursal dentro del grupo (ej. "Sucursal Centro"). */
  direccion        String?
  /** Color (hex, ej. "#1c02ab") para identificar visualmente la sucursal en el selector. */
  color            String?
  createdAt        DateTime  @default(now())

  employees        Employee[]
  attendance       AttendanceRecord[]
  absences         Absence[]
  users            AppUser[]
  holidays         Holiday[]
  shiftTemplates   ShiftTemplate[]
  shiftAssignments ShiftAssignment[]

  @@index([planId])
  @@index([grupoId])
  @@map("companies")
}

/** Agrupa varias Company (sucursales) bajo un mismo cliente corporativo, para que
 * un solo login de Admin pueda elegir qué sucursal ver. */
model EmpresaGrupo {
  id         String    @id @default(uuid())
  nombre     String
  createdAt  DateTime  @default(now())

  sucursales Company[]

  @@map("empresa_grupos")
}

/** Catálogo de planes que gestiona el SuperAdmin — son los que se muestran en
 * /planes y en el landing, y los que se pueden asignar al crear/editar una empresa. */
model Plan {
  id             String   @id @default(uuid())
  nombre         String
  precio         String
  /** Precio de lista tachado, para mostrar descuento promocional (opcional). */
  precioOriginal String?
  maxEmpleados   Int
  maxAdmins      Int
  /** Mínimo 5, validado también en la API. */
  diasGracia     Int      @default(5)
  detalle        String[] @default([])
  destacado      Boolean  @default(false)
  /** Habilita, al crear la empresa, cargar varias sucursales bajo un mismo login. */
  esCorporativo  Boolean  @default(false)
  /** Si está apagado, deja de mostrarse en /planes y el landing, pero las
   * empresas que ya lo tienen asignado no se ven afectadas. */
  activo         Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())

  companies Company[]

  @@map("plans")
}

model Employee {
  id           String    @id @default(uuid())
  empresaId    String
  empresa      Company   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  legajo       String    @default("")
  dni          String    @default("")
  puesto       String    @default("")
  area         String    @default("")
  email        String    @default("")
  telefono     String    @default("")
  fechaIngreso DateTime? @db.Date
  shiftId      String?
  shift        ShiftTemplate? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  estado       String    @default("Activo")
  salarioBase  Float?
  createdAt    DateTime  @default(now())

  attendance       AttendanceRecord[]
  absences         Absence[]
  shiftAssignments ShiftAssignment[]
  users            AppUser[]

  @@index([empresaId])
  @@index([shiftId])
  @@map("employees")
}

model AttendanceRecord {
  id              String   @id @default(uuid())
  empresaId       String
  empresa         Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  registro        String   @default("")
  fecha           DateTime @db.Date
  horaEntrada     String   @default("")
  horaSalida      String?
  horasTrabajadas Float?
  horasExtra      Float?
  llegadaTarde    Boolean  @default(false)
  minutosTardanza Int?
  observaciones   String   @default("")
  latitud         Float?
  longitud        Float?
  precision       Float?
  latitudSalida   Float?
  longitudSalida  Float?
  precisionSalida Float?
  createdAt       DateTime @default(now())

  @@index([empresaId, fecha])
  @@index([employeeId, fecha])
  @@map("attendance_records")
}

model Absence {
  id            String   @id @default(uuid())
  empresaId     String
  empresa       Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fechaInicio   DateTime @db.Date
  fechaFin      DateTime @db.Date
  tipo          String
  observaciones String   @default("")

  @@index([empresaId])
  @@index([employeeId])
  @@map("absences")
}

model AppUser {
  id           String   @id @default(uuid())
  empresaId    String?
  empresa      Company? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  rol          String
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@map("app_users")
}

model Holiday {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  fecha     DateTime @db.Date
  tipo      String

  @@index([empresaId, fecha])
  @@map("holidays")
}

model ShiftTemplate {
  id          String   @id @default(uuid())
  empresaId   String
  empresa     Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre      String
  horaEntrada String
  horaSalida  String

  employees   Employee[]
  assignments ShiftAssignment[]

  @@index([empresaId])
  @@map("shift_templates")
}

model ShiftAssignment {
  id          String    @id @default(uuid())
  empresaId   String
  empresa     Company   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId     String
  shift       ShiftTemplate @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  fechaInicio DateTime  @db.Date
  fechaFin    DateTime? @db.Date
  diasSemana  String[]  @default([])
  esFijo      Boolean   @default(false)

  @@index([empresaId])
  @@index([employeeId])
  @@map("shift_assignments")
}
